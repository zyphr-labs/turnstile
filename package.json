{
  "name": "@zyphr-labs/turnstile",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.3.13",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "version": "0.1.0-alpha.3",
  "description": "Guardrails for AI agent actions on laptops and servers.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "bun": ">=1.3.13"
  },
  "packageManager": "bun@1.3.13",
  "repository": {
    "type": "git",
    "url": "https://github.com/zyphr-labs/turnstile.git"
  },
  "scripts": {
    "verify": "bun run lint && bun run typecheck && bun test && bun run demo",
    "lint": "biome check --error-on-warnings .",
    "format": "biome check --write .",
    "typecheck": "bun ./node_modules/typescript/bin/tsc --noEmit",
    "test": "bun test",
    "demo": "bun run examples/guarded-action.ts",
    "test:live": "bun run scripts/live.ts",
    "cli": "bun run src/cli.ts",
    "test:claude": "bun run scripts/claude-e2e.ts",
    "test:opencode": "bun run scripts/opencode-e2e.ts",
    "test:pi": "bun run scripts/pi-e2e.ts",
    "test:harnesses": "bun run test:opencode && bun run test:pi",
    "test:live:harnesses": "bun run scripts/opencode-e2e.ts --live && bun run scripts/pi-e2e.ts --live",
    "eval": "bun run scripts/evaluate.ts",
    "eval:live": "bun run scripts/evaluate.ts --live"
  }
}
